#!/bin/sh
# Fetch the locked dependencies for a fresh clone.
# tehas runs this with sh from the worktree root, so it is POSIX sh.
# Yarn 1 is in the factory's sandbox image. The Cypress binary (about 500 MB)
# is skipped: the fast gate does not run Cypress.
set -eu
CYPRESS_INSTALL_BINARY=0 yarn install --frozen-lockfile
